{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/franchise",
      "destination": "https://phonofilm.net/svc/api/franchise"
    },
    {
      "source": "/api/franchise/:slug",
      "destination": "https://phonofilm.net/svc/api/franchise/:slug"
    },
    {
      "source": "/movie/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawl|spider|slurp|facebook|whatsapp|telegram|twitterbot|linkedinbot|discord|slack|pinterest|embedly|quora|outbrain|vkshare|facebookexternalhit|Facebot|W3C_Validator).*"
        }
      ],
      "destination": "https://khwwpvctzyurngshagke.supabase.co/functions/v1/og-image/movie/:id"
    },
    {
      "source": "/tv/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawl|spider|slurp|facebook|whatsapp|telegram|twitterbot|linkedinbot|discord|slack|pinterest|embedly|quora|outbrain|vkshare|facebookexternalhit|Facebot|W3C_Validator).*"
        }
      ],
      "destination": "https://khwwpvctzyurngshagke.supabase.co/functions/v1/og-image/tv/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
